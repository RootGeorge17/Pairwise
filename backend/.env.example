PAIRWISE_DB_URL=jdbc:mariadb://localhost:3306/pairwise_db
PAIRWISE_DB_USERNAME=pairwise_user
PAIRWISE_DB_PASSWORD=change-me
PAIRWISE_JPA_SHOW_SQL=true

PAIRWISE_SANDBOX_CPUS=0.5
PAIRWISE_SANDBOX_PIDS_LIMIT=64
PAIRWISE_SANDBOX_TMPFS=/tmp:rw,noexec,nosuid,size=16m
PAIRWISE_SANDBOX_EXTRA_TIMEOUT_BUFFER_MS=1000
PAIRWISE_SANDBOX_MAX_OUTPUT_BYTES=65536
PAIRWISE_SANDBOX_ENABLE_SELINUX_LABEL=true

PAIRWISE_JWT_SECRET=change-me-to-a-long-random-secret
PAIRWISE_ACCESS_TOKEN_EXPIRY_MS=1800000
PAIRWISE_REFRESH_TOKEN_EXPIRY_MS=1209600000